{
  "version": 1,
  "attemptLimit": 3,
  "checks": [
    {
      "name": "unit",
      "command": [
        "node",
        "--test",
        "tests/*.test.mjs"
      ],
      "timeoutSeconds": 180
    },
    {
      "name": "static",
      "command": [
        "node",
        "scripts/check.mjs"
      ],
      "timeoutSeconds": 90
    }
  ]
}
