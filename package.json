{
  "name": "banana-skyline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two monkeys, a windy skyline, and bananas. Plays in a desktop browser and in VR on Meta Quest (WebXR).",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
