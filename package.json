    "deploy": "node scripts/deploy.mjs",
    "apk": "node scripts/apk.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "iwer": "2.5.0"
  }
}
